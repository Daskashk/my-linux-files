{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "› ",
    "key": {
      "width": 14
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "───────────────────"
    },
    {
      "type": "os",
      "key": "  OS"
    },
    {
      "type": "kernel",
      "key": "  Kernel"
    },
    {
      "type": "uptime",
      "key": "󰅐  Uptime"
    },
    {
      "type": "packages",
      "key": "󰏖  Packages"
    },
    {
      "type": "shell",
      "key": "󰆍  Shell"
    },
    {
      "type": "wm",
      "key": "󰧨  WM"
    },
    {
      "type": "terminal",
      "key": "󰆍  Terminal"
    },
    {
      "type": "cpu",
      "key": "󰻠  CPU"
    },
    {
      "type": "gpu",
      "key": "󰢮  GPU"
    },
    {
      "type": "memory",
      "key": "󰍛  Memory"
    },
    {
      "type": "swap",
      "key": "󰓅  Swap"
    },
    {
      "type": "disk",
      "key": "󰋊  Disk",
      "folders": "/"
    },
    "break"
  ]
}
